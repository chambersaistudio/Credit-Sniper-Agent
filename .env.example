# Backend environment (Railway service variables, or backend/.env locally).
# The frontend has only two vars, both set in Vercel and both browser-safe:
#   VITE_API_URL                 the API origin (below, under Database notes)
#   VITE_CLERK_PUBLISHABLE_KEY   Clerk's PUBLISHABLE key (pk_...) — public by
#                                design. Never put a secret in a VITE_ var.

# ── AI providers ─────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to use an `ant auth login` profile locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional per-tier routing overrides. Defaults (backend/app/services/ai/config.py):
#   FAST                 claude-haiku-4-5
#   REASONING            claude-opus-5, effort high
#   ESCALATION           claude-opus-5, effort max
#   DOCUMENT_EXTRACTION  openai gpt-5.6-sol   (reads the original PDF)
#   DOCUMENT_AUDIT       openai gpt-5.6-sol   (independently audits that reading)
# AI_REASONING_PROVIDER=anthropic
# AI_REASONING_MODEL=claude-opus-5
# AI_REASONING_EFFORT=high
# Both document passes start on Sol for accuracy. Once a benchmark exists,
# gpt-5.6-terra is the candidate cheaper extractor with Sol still auditing.
# AI_DOCUMENT_EXTRACTION_MODEL=gpt-5.6-sol
# AI_DOCUMENT_AUDIT_MODEL=gpt-5.6-sol

# ── Document understanding ───────────────────────────────────────
# Ingestion sends the ORIGINAL uploaded PDF to the document model, never text
# a local parser derived from it. Empty = on whenever OPENAI_API_KEY is set;
# "off" keeps the deterministic parser, which then can't reach "verified".
DOCUMENT_EXTRACTION_MODE=
# Page rendering detail. Credit reports have small text and dense grids.
DOCUMENT_EXTRACTION_DETAIL=high
# Second pass: an independent audit of the extraction against the same PDF.
DOCUMENT_AUDIT_ENABLED=true

# ── Database ─────────────────────────────────────────────────
# postgres:// and postgresql:// URLs (Railway's format) are converted for the async driver.
DATABASE_URL=postgresql://creditsniper:password@localhost:5432/creditsniper
# Apply migrations at boot. Set false where a pre-deploy step runs `alembic upgrade head`.
RUN_MIGRATIONS_ON_STARTUP=true

# ── Authentication ───────────────────────────────────────────
# "jwt"      — REQUIRED for any hosted/multi-user deployment. Every data
#              request must carry a provider-signed bearer token; identity
#              comes only from the verified token.
# "disabled" — local dev/tests only: no auth, one local user. Never expose a
#              disabled deployment to the internet with real data.
AUTH_MODE=disabled
# From the managed auth provider (Clerk in our setup). These are PUBLIC, not
# secrets — verification uses the provider's public keys, so no provider
# secret key is needed on the backend at all.
#   Clerk: JWKS URL is <Frontend API URL>/.well-known/jwks.json
#          Issuer is the Frontend API URL, e.g. https://xxxx.clerk.accounts.dev
AUTH_JWKS_URL=
AUTH_ISSUER=
# Optional: set only if your provider stamps an audience you want checked.
AUTH_AUDIENCE=

# ── CORS ─────────────────────────────────────────────────────
# Exact frontend origins, comma-separated (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs, e.g. ^https://credit-sniper-[a-z0-9-]+-yourteam\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# ── Document storage ─────────────────────────────────────────
# local = directory (UPLOAD_DIR); r2 = private Cloudflare R2 bucket.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MAX_FILE_SIZE_MB=50

# ── Admin ────────────────────────────────────────────────────
# Required to call POST /api/migrate (disabled when empty).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
DEBUG=false
