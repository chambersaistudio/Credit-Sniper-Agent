# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://creditsniper:password@localhost:5432/creditsniper
SYNC_DATABASE_URL=postgresql://creditsniper:password@localhost:5432/creditsniper

# Redis (for task queue)
REDIS_URL=redis://localhost:6379/0

# App
SECRET_KEY=your_secret_key_here
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email monitoring (Phase 2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Credit API (Phase 3 - research CRS Credit API, iSoftpull, Bloom Credit)
CREDIT_API_KEY=
CREDIT_API_PROVIDER=

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
