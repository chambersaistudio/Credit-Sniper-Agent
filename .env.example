# Backend environment (Railway service variables, or backend/.env locally).
# Frontend has exactly one variable, VITE_API_URL, set in Vercel — never put secrets there.

# ── AI providers ─────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to use an `ant auth login` profile locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional per-tier routing overrides (tiers: FAST, REASONING, ESCALATION).
# Defaults (backend/app/services/ai/config.py):
#   FAST       claude-haiku-4-5
#   REASONING  claude-opus-5, effort high
#   ESCALATION claude-opus-5, effort max
# AI_REASONING_PROVIDER=anthropic
# AI_REASONING_MODEL=claude-opus-5
# AI_REASONING_EFFORT=high

# ── Database ─────────────────────────────────────────────────
# postgres:// and postgresql:// URLs (Railway's format) are converted for the async driver.
DATABASE_URL=postgresql://creditsniper:password@localhost:5432/creditsniper
# Apply migrations at boot. Set false where a pre-deploy step runs `alembic upgrade head`.
RUN_MIGRATIONS_ON_STARTUP=true

# ── CORS ─────────────────────────────────────────────────────
# Exact frontend origins, comma-separated (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs, e.g. ^https://credit-sniper-[a-z0-9-]+-yourteam\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# ── Document storage ─────────────────────────────────────────
# local = directory (UPLOAD_DIR); r2 = private Cloudflare R2 bucket.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MAX_FILE_SIZE_MB=50

# ── Admin ────────────────────────────────────────────────────
# Required to call POST /api/migrate (disabled when empty).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
DEBUG=false
