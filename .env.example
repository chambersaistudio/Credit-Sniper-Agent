# ── AI providers ─────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional per-tier routing overrides (tiers: FAST, REASONING, ESCALATION).
# Defaults live in backend/app/services/ai/config.py.
# AI_REASONING_PROVIDER=anthropic
# AI_REASONING_MODEL=claude-opus-5
# AI_REASONING_EFFORT=high

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://creditsniper:password@localhost:5432/creditsniper

# ── App ──────────────────────────────────────────────────────
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Required to call POST /api/migrate (disabled when empty).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ── File storage ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
