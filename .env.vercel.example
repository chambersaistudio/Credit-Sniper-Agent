# Set in: Vercel Dashboard → Project → Settings → Environment Variables

# AI provider key(s)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=

# Vercel Postgres / Neon: added automatically when you connect a database.
# postgres:// and ?sslmode= URLs are converted for the async driver automatically.
POSTGRES_URL_NON_POOLING=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Protects POST /api/migrate — call it once after each deploy with header X-Admin-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Your production domain, for CORS
ALLOWED_ORIGINS=https://your-app.vercel.app
