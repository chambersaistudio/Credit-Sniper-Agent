# ─────────────────────────────────────────────────────────────
# Vercel Environment Variables
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Vercel Postgres (Neon) — added automatically when you connect a Vercel Postgres DB.
# If using external Neon/Supabase, paste the connection string here.
# Must use the NON-POOLING URL so SQLAlchemy manages its own connections.
POSTGRES_URL_NON_POOLING=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Set your production domain here for CORS
ALLOWED_ORIGINS=https://your-app.vercel.app

# Vercel sets this automatically — do not set manually
# VERCEL=1
